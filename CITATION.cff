    given-names: "Rithish"
    affiliation: "The University of Sheffield"
license: MIT
date-released: 2026-09-16
url: "https://github.com/rithish007/Shallow_Seabed"
repository-code: "https://github.com/rithish007/Shallow_Seabed"
keywords:
  - underwater simulation
  - Unreal Engine
  - synthetic data
  - instance annotation
identifiers:
