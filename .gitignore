# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Project-specific: not published to the public repo
# 12GB raw survey captures + the Baseline_Set YOLO dataset built from them (separate from
# what's already published on the HF dataset repo) -- stays local only. Exception: the
# training/eval pipeline scripts themselves are small, pure code, and do get published.
Dataset/*
!Dataset/Baseline_Set/
Dataset/Baseline_Set/*
!Dataset/Baseline_Set/scripts/

# Purchased "Thai Beach Corals" asset pack (shared asset id ufzkbcjfa) -- 3 of its 8 files
# exceed GitHub's 100MB/file hard limit, and its Marketplace/Fab license may restrict
# redistributing the raw files. Stays local; the project still opens fine without it pushed.
*ufzkbcjfa*

# Claude Code / VibeUE agent tooling -- dev-tool config and plugin, not part of the simulator.
CLAUDE.md
.mcp.json
.claude/
Plugins/Marketplace/VibeUE/
